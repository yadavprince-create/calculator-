num1 = float(input("enter your number_1:  "))
user_input = input("enter (+,-,/,*) :  ")
num2 = float(input("enter your number_2:  "))

match  user_input:
    case "+":
        print(num1 + num2)
    case "-":
        print(num1 - num2)
    case "*":
        print(num1 * num2)
    case "/":
        print(num1 / num2)
    case "!":
        if num2 !=0:
            print(num1 / num2) 
        else: 
            print("Error,")
    case _:
        print("Here is result")






